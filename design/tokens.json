{
  "$comment": "The Claude look (docs/superpowers/specs/2026-11-22-claude-look-design.md). One source for the dashboard (ui/src/design/tokens.css) and the phone app (android/.../ui/look/Tokens.kt). Edit here, then run `npm run tokens`.",
  "colors": {
    "ground":    { "dark": "#000000", "light": "#F6F3EC", "for": "The window / screen" },
    "dots":      { "dark": "#1C1C1C", "light": "#D9D4CA", "for": "The dotted-paper grid on the ground" },
    "card":      { "dark": "#0A0A0A", "light": "#FFFFFF", "for": "Inside a card" },
    "card-bar":  { "dark": "#161616", "light": "#E9E5DC", "for": "A card's title bar, a table head" },
    "soft":      { "dark": "#242220", "light": "#E9E5DC", "for": "Inactive bars, dividers inside cards, skeleton fill" },
    "ink":       { "dark": "#F2EEE6", "light": "#111111", "for": "Outlines and main text" },
    "ink-2":     { "dark": "#B8B2A7", "light": "#4A4640", "for": "Secondary text" },
    "ink-3":     { "dark": "#8A847A", "light": "#625C53", "for": "Hints, timestamps, disabled (AA on card in both)" },
    "shadow":    { "dark": "#3A3631", "light": "#111111", "for": "The hard offset shadow" },
    "accent":    { "dark": "#D97757", "light": "#D9693F", "for": "Primary action, current item, progress fill" },
    "accent-ink":{ "dark": "#D97757", "light": "#A8461F", "for": "Orange used as text (AA on card)" },
    "on-accent": { "dark": "#000000", "light": "#000000", "for": "Text on orange" },
    "ok":        { "dark": "#3FB950", "light": "#1F7A35", "for": "On, online, allowed, done" },
    "danger":    { "dark": "#F85149", "light": "#C42B24", "for": "Stop, refused, failed, delete" },
    "warn":      { "dark": "#E3B341", "light": "#9A6700", "for": "Waiting, ask" }
  },
  "sizes": {
    "outline": 2,
    "hairline": 1,
    "shadow-card": 4,
    "shadow-button": 3,
    "dots-gap": 16,
    "pad-card": 14
  },
  "type": {
    "display": [56, 52],
    "number": [32, 36],
    "title": [22, 28],
    "label": [13, 16],
    "body": [15, 22],
    "small": [13, 18],
    "micro": [11, 14]
  },
  "fonts": {
    "sans": "Archivo",
    "mono": "JetBrains Mono"
  }
}
